import "LoadingMessages.bs"
import "pkg:/source/Dialog.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Manifest.bs"
import "pkg:/source/Registry.bs"

' download + load of the lib on a slow TV; after this the embedded lib is used
const UPDATE_TIMEOUT_SECONDS = 45

function Init() as void
    m.scene = m.top.getScene()
    m.top.backgroundColor = "#161616FF"
    m.top.backgroundURI = ""

    m.loadingIndicator = m.top.findNode("LoadingIndicator")
    m.global.addFields({
        loadingIndicator: m.loadingIndicator
    })

    m.loadingIndicator.visible = true
    m.loadingIndicator.message = GetLoadingMessage()

    m.playletLibUrls = GetPlayletLibUrls()
    m.playletLibUrlIndex = 0

    ' a download that hangs (slow or no internet) gives up after this and the next url is tried
    m.loadTimeout = m.top.createChild("Timer")
    m.loadTimeout.duration = UPDATE_TIMEOUT_SECONDS
    m.loadTimeout.repeat = false
    ' bs:disable-next-line NO_OBSERVE_STRING_CALLBACK
    m.loadTimeout.observeField("fire", "OnLoadTimeout")

    LoadPlayletLib()
end function

function GetPlayletLibUrls() as object
    #if DEBUG
        debug = { type: "debug-zip", link: Manifest.ReadValue("playlet_lib_zip_debug_url") }
        embedded = { type: "embedded-zip", link: Manifest.ReadValue("playlet_lib_zip_embedded_url") }
        #if DEBUG_FALLBACK_TO_EMBEDDED
            return [debug, embedded]
        #else
            return [debug]
        #end if
    #else
        ' Auto-update: this fork's latest build, from its own GitHub repo (tv-updates branch), then the lib
        ' bundled in the package when that can't be loaded. It never downloads the upstream release, and
        ' never loads a lib from a URL saved in the registry (clearing any left there by another build).
        Registry.DeleteKey("playlet_lib_urls", "Playlet")
        urls = []
        updateUrl = Manifest.ReadValue("playlet_lib_zip_update_url")
        if updateUrl <> invalid and updateUrl <> ""
            urls.push({ type: "update-zip", link: updateUrl })
        end if
        urls.push({ type: "embedded-zip", link: Manifest.ReadValue("playlet_lib_zip_embedded_url") })
        return urls
    #end if
end function

function LoadPlayletLib() as void
    if m.playletLibUrlIndex >= m.playletLibUrls.Count()
        m.loadingIndicator.visible = false
        if m.shouldClearRegistryOnLoadFail = true
            Registry.DeleteKey("playlet_lib_urls", "Playlet")
        end if
        ShowPlayletLibLoadErrorDialog()
        return
    end if

    RemoveComponentLibrary()
    libUrl = m.playletLibUrls[m.playletLibUrlIndex]
    uri = libUrl.link
    if libUrl.type = "update-zip"
        ' the plain url: the library loader goes by the ".zip" ending (a query string after it made the load
        ' fail on the TV, falling back to the embedded lib every time)
        m.loadTimeout.control = "start"
    end if
    LoadComponentLibrary(uri)
end function

function OnLoadTimeout() as void
    if m.lib = invalid or m.lib.loadStatus = "ready"
        return
    end if
    Logger.Log(`Playlet lib download timed out after ${UPDATE_TIMEOUT_SECONDS} s, trying the next url`)
    m.playletLibUrlIndex += 1
    LoadPlayletLib()
end function

function OnLoadStatusChanged() as void
    libUrl = m.playletLibUrls[m.playletLibUrlIndex]
    if m.lib.loadStatus = "ready" or m.lib.loadStatus = "failed"
        m.loadTimeout.control = "stop"
    end if
    if m.lib.loadStatus = "ready"
        RemoveComponentLibrary()
        Logger.Log(`Playlet lib loaded from ${libUrl.link} in ${m.timer.TotalMilliseconds()} ms`)
        m.timer = invalid
        m.scene.playletLibLoadedUrl = libUrl
        container = m.scene.findNode("MainSceneContainer")
        container.createChild("PlayletLib:MainScene")
        m.scene.libSceneCreated = true
        return
    end if

    if m.lib.loadStatus = "failed"
        Logger.Log(`Playlet lib failed to load from ${libUrl.link} in ${m.timer.TotalMilliseconds()} ms`)
        ' Try next url
        m.playletLibUrlIndex += 1
        LoadPlayletLib()
    end if
end function

function CreateInputTransportEventsHandler(_unused as dynamic) as object
    return CreateObject("roSGNode", "PlayletLib:InputTransportEventsHandler")
end function

function RemoveComponentLibrary() as void
    if m.lib = invalid
        return
    end if

    m.lib.unobserveField("loadStatus")
    m.scene.removeChild(m.lib)
    m.lib = invalid
end function

function LoadComponentLibrary(uri as string)
    m.timer = CreateObject("roTimespan")
    m.timer.mark()

    m.lib = m.scene.createChild("ComponentLibrary")
    ' bs:disable-next-line NO_OBSERVE_STRING_CALLBACK
    m.lib.observeField("loadStatus", "OnLoadStatusChanged")

    Logger.Log(`Loading Playlet lib from ${uri}`)
    m.lib.uri = uri
end function

function ShowPlayletLibLoadErrorDialog()
    message = [
        "Could not load Playlet component library from any of the following urls:",
    ]

    bulletText = []
    for each url in m.playletLibUrls
        bulletText.push("[" + url.type + "] " + url.link)
    end for

    bottomText = [
        "Please restart Playlet.",
        "If the problem persist, contact Playlet authors."
    ]

    DialogShowError(message, bulletText, bottomText)
end function
