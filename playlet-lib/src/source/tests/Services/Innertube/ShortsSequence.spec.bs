import "pkg:/components/Services/Innertube/ShortsSequence.bs"

namespace Tests

    @suite
    class ShortsSequenceTests extends Rooibos.BaseTestSuite

        @describe("InnertubeShorts.ParseSequence")

        @it("collects every Short once, skips the starting one, and finds the continuation token")
        function _()
            json = {
                entries: [
                    { command: { reelWatchEndpoint: { videoId: "start" } } }
                    { command: { reelWatchEndpoint: { videoId: "a" } } }
                    { command: { reelWatchEndpoint: { videoId: "b", overlay: { reelWatchEndpoint: { videoId: "c" } } } } }
                    { command: { reelWatchEndpoint: { videoId: "a" } } }
                ]
                continuationEndpoint: { continuationCommand: { token: "next-token" } }
            }
            result = InnertubeShorts.ParseSequence(json, "start")
            m.assertEqual(result.items.Count(), 3)
            m.assertEqual(result.items[0].videoId, "a")
            m.assertEqual(result.items[1].videoId, "b")
            m.assertEqual(result.items[2].videoId, "c")
            m.assertEqual(result.items[0].type, "video")
            m.assertEqual(result.continuation, "next-token")
        end function

        @it("returns nothing for an unexpected response")
        function _()
            result = InnertubeShorts.ParseSequence({ unexpected: true }, "")
            m.assertEqual(result.items.Count(), 0)
            m.assertEqual(result.continuation, "")
            m.assertEqual(InnertubeShorts.ParseSequence(invalid, "").items.Count(), 0)
        end function

        @describe("InnertubeShorts.FindString")

        @it("finds the sequence parameters anywhere in the response")
        function _()
            json = { replacementEndpoint: { reelWatchEndpoint: { sequenceContinuation: "seq" } } }
            m.assertEqual(InnertubeShorts.FindString(json, "sequenceContinuation", 12), "seq")
            m.assertEqual(InnertubeShorts.FindString(json, "missing", 12), "")
        end function

    end class

end namespace
