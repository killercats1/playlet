import "pkg:/components/Services/Innertube/MusicHome.bs"

namespace Tests

    @suite
    class MusicHomeTests extends Rooibos.BaseTestSuite

        @describe("InnertubeMusic.ParseHome")

        @it("reads songs, playlists, albums and artists from every shelf, without duplicates")
        function _()
            song = {
                musicResponsiveListItemRenderer: {
                    playlistItemData: { videoId: "song1" }
                    flexColumns: [
                        { musicResponsiveListItemFlexColumnRenderer: { text: { runs: [{ text: "Song One" }] } } }
                        { musicResponsiveListItemFlexColumnRenderer: { text: { runs: [{ text: "Artist", navigationEndpoint: { browseEndpoint: { browseId: "UCartist" } } }] } } }
                    ]
                }
            }
            playlist = {
                musicTwoRowItemRenderer: {
                    title: { runs: [{ text: "My Mix" }] }
                    subtitle: { runs: [{ text: "Playlist" }] }
                    navigationEndpoint: { browseEndpoint: { browseId: "VLPL123" } }
                    thumbnailRenderer: { musicThumbnailRenderer: { thumbnail: { thumbnails: [{ url: "https://lh3.googleusercontent.com/abc=w120-h120-l90-rj" }] } } }
                }
            }
            album = {
                musicTwoRowItemRenderer: {
                    title: { runs: [{ text: "Album" }] }
                    navigationEndpoint: { browseEndpoint: { browseId: "MPREb_1" } }
                    thumbnailOverlay: { musicItemThumbnailOverlayRenderer: { content: { musicPlayButtonRenderer: { playNavigationEndpoint: { watchPlaylistEndpoint: { playlistId: "OLAK5uy_1" } } } } } }
                }
            }
            artist = {
                musicTwoRowItemRenderer: {
                    title: { runs: [{ text: "Some Artist" }] }
                    navigationEndpoint: { browseEndpoint: { browseId: "UCsome" } }
                }
            }
            video = {
                musicTwoRowItemRenderer: {
                    title: { runs: [{ text: "Video" }] }
                    navigationEndpoint: { watchEndpoint: { videoId: "vid1" } }
                }
            }
            payload = {
                contents: {
                    singleColumnBrowseResultsRenderer: {
                        tabs: [{
                            tabRenderer: {
                                content: {
                                    sectionListRenderer: {
                                        contents: [
                                            { musicCarouselShelfRenderer: { contents: [song, playlist] } }
                                            { musicCarouselShelfRenderer: { contents: [album, artist, video, song] } }
                                            { somethingElse: {} }
                                        ]
                                    }
                                }
                            }
                        }]
                    }
                }
            }

            items = InnertubeMusic.ParseHome(payload)
            m.assertEqual(items.Count(), 5)
            m.assertEqual(items[0].type, "video")
            m.assertEqual(items[0].videoId, "song1")
            m.assertEqual(items[0].title, "Song One")
            m.assertEqual(items[0].author, "Artist")
            m.assertEqual(items[0].authorId, "UCartist")
            m.assertEqual(items[1].type, "playlist")
            m.assertEqual(items[1].playlistId, "PL123")
            m.assertEqual(items[1].playlistThumbnail, "https://lh3.googleusercontent.com/abc=w544-h544-l90-rj")
            m.assertEqual(items[2].playlistId, "OLAK5uy_1")
            m.assertEqual(items[3].type, "channel")
            m.assertEqual(items[3].authorId, "UCsome")
            m.assertEqual(items[4].videoId, "vid1")
        end function

        @it("returns nothing for an unexpected payload")
        function _()
            m.assertEqual(InnertubeMusic.ParseHome({ unexpected: true }).Count(), 0)
            m.assertEqual(InnertubeMusic.ParseHome(invalid).Count(), 0)
        end function

    end class

end namespace
