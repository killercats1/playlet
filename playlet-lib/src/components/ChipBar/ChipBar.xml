<component name="ChipBar" extends="Group" includes="Focus">
    <!-- A row of topic chips (All, Music, Gaming, ...) at the top of Home. Hidden until `chips` has some.
         Left/Right move between chips; OK picks one (`selected` fires with that chip). -->
    <interface>
        <!-- [{ title, continuation, isSelected }] -->
        <field id="chips" type="array" onChange="OnChipsChange" />
        <field id="selected" type="assocarray" alwaysNotify="true" />
        <field id="hasChips" type="boolean" value="false" />
    </interface>
    <children>
        <Group id="chipsGroup" />
    </children>
</component>
