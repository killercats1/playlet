import "pkg:/source/utils/RegistryUtils.bs"
import "pkg:/source/utils/StringUtils.bs"
import "pkg:/source/utils/Types.bs"

' Videos and channels the user marked "Not interested" / "Don't recommend channel", kept on the TV so they leave
' every feed right away (YouTube itself can take a while to stop sending them).
' The registry is small (16KB for the whole app), so only the latest ids are kept.
namespace FeedFilters

    const REGISTRY_KEY = "feed_hidden"
    const MAX_VIDEOS = 100
    const MAX_CHANNELS = 60

    ' -> { videos: [ids], channels: [ids] }
    function Load() as object
        saved = StringUtils.ParseJsonSafe(ValidString(RegistryUtils.Read(REGISTRY_KEY)))
        result = { videos: [], channels: [] }
        if IsAssociativeArray(saved)
            if IsArray(saved.videos)
                result.videos = saved.videos
            end if
            if IsArray(saved.channels)
                result.channels = saved.channels
            end if
        end if
        return result
    end function

    ' kind: "video" or "channel"
    function Remember(kind as string, id as string) as void
        if id = ""
            return
        end if
        saved = FeedFilters.Load()
        if kind = "channel"
            saved.channels = FeedFilters.AddCapped(saved.channels, id, MAX_CHANNELS)
        else
            saved.videos = FeedFilters.AddCapped(saved.videos, id, MAX_VIDEOS)
        end if
        RegistryUtils.Write(REGISTRY_KEY, FormatJson(saved))
    end function

    function AddCapped(ids as object, id as string, maxCount as integer) as object
        kept = []
        for each existing in ids
            if IsString(existing) and existing <> id
                kept.Push(existing)
            end if
        end for
        kept.Push(id)
        while kept.Count() > maxCount
            kept.Shift()
        end while
        return kept
    end function

    ' -> { videos: { id: true }, channels: { id: true } } for quick lookups
    function LoadLookup() as object
        saved = FeedFilters.Load()
        lookup = { videos: {}, channels: {} }
        for each id in saved.videos
            if IsString(id)
                lookup.videos[id] = true
            end if
        end for
        for each id in saved.channels
            if IsString(id)
                lookup.channels[id] = true
            end if
        end for
        return lookup
    end function

    function Clear() as void
        RegistryUtils.Delete(REGISTRY_KEY)
    end function

end namespace
