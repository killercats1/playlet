import "pkg:/components/Services/Innertube/Context.bs"
import "pkg:/components/Services/Innertube/Parser.bs"
import "pkg:/components/Services/Innertube/protos/params.proto.gen.bs"
import "pkg:/source/services/HttpClient.bs"
import "pkg:/source/utils/Logging.bs"
import "pkg:/source/utils/ObjectUtils.bs"
import "pkg:/source/utils/Types.bs"

namespace Innertube

    function CreateNextRequest(payloadArgs as object, options = invalid as object) as HttpClient.Request
        deviceInfo = CreateObject("roDeviceInfo")

        context = Innertube.CreateContext(Innertube.ClientType.Web, deviceInfo, options)

        payload = {
            "context": context
        }
        payload.Append(payloadArgs)

        request = HttpClient.Post("https://www.youtube.com/youtubei/v1/next?prettyPrint=false&alt=json").JsonBody(payload)
        request.Headers(Innertube.CreateHeaders(Innertube.ClientType.Web))

        return request
    end function

    function GetEncodedNextParams(videoIds as object) as string
        if not IsArray(videoIds) or videoIds.Count() = 0
            return ""
        end if

        return Protobuf.Generated.misc.encodeNextParams({
            "video_id": videoIds
        })
    end function

    function ParseInnertubeNextResponse(payload as object, parsedResponse as object, request as HttpClient.Request) as object
        if not IsAssociativeArray(payload)
            LogWarn("Invalid payload", payload)
            return parsedResponse
        end if

        playerOverlayRenderer = ObjectUtils.Dig(payload, ["playerOverlays", "playerOverlayRenderer"])
        if not IsAssociativeArray(playerOverlayRenderer)
            LogWarn("Invalid playerOverlayRenderer", playerOverlayRenderer)
            return parsedResponse
        end if

        endscreen = playerOverlayRenderer["endScreen"]

        feeds = Innertube.ParseResponseDataForFeeds(endscreen, {
            request: request
            noContainers: true
        })
        if feeds.Count() > 0
            parsedResponse["recommendedVideos"] = ValidArray(feeds[0].items)
        end if

        ' chapters for the player's progress bar
        videoChapters = Innertube.ParseNextChapters(payload)
        if videoChapters.Count() > 0
            parsedResponse["chapters"] = videoChapters
        end if

        ' Sometimes the title and author are missing in /player respnonse, so we get them here.
        ' But if we have an error, we don't need them, recommendedVideos is enough to play the
        ' next video, after showing the error dialog.
        if parsedResponse.error <> invalid
            return parsedResponse
        end if

        if StringUtils.IsNullOrEmpty(parsedResponse.title)
            title = ParseText(ObjectUtils.Dig(playerOverlayRenderer, ["videoDetails", "playerOverlayVideoDetailsRenderer", "title"]))
            if not StringUtils.IsNullOrEmpty(title)
                parsedResponse.title = title
            end if
        end if

        if StringUtils.IsNullOrEmpty(parsedResponse.author)
            subtitle = ParseText(ObjectUtils.Dig(playerOverlayRenderer, ["videoDetails", "playerOverlayVideoDetailsRenderer", "subtitle"]))
            if not StringUtils.IsNullOrEmpty(subtitle)
                parsedResponse.author = subtitle
            end if
        end if

        return parsedResponse
    end function

    ' The video's chapters, [{ title, startMs }] in order: YouTube's own chapter markers (the player bar's
    ' chapterRenderer list), or else the timestamps in the description ("0:00 Intro").
    function ParseNextChapters(payload as object) as object
        list = []
        markers = Innertube.FindChapterMarkers(payload["playerOverlays"], 24)
        if IsArray(markers)
            for each marker in markers
                renderer = ObjectUtils.Dig(marker, ["chapterRenderer"])
                if IsAssociativeArray(renderer) and IsNumber(renderer["timeRangeStartMillis"])
                    list.Push({ title: ParseText(renderer["title"]), startMs: renderer["timeRangeStartMillis"] })
                end if
            end for
        end if
        if list.Count() >= 2
            return list
        end if
        contents = ObjectUtils.Dig(payload, ["contents", "twoColumnWatchNextResults", "results", "results", "contents"])
        if IsArray(contents)
            for each item in contents
                secondary = ObjectUtils.Dig(item, ["videoSecondaryInfoRenderer"])
                if IsAssociativeArray(secondary)
                    descriptionText = ValidString(ObjectUtils.Dig(secondary, ["attributedDescription", "content"]))
                    return Innertube.ChaptersFromDescription(descriptionText)
                end if
            end for
        end if
        return []
    end function

    ' The first "chapters" list of chapterRenderer items under data.
    function FindChapterMarkers(data as dynamic, depth as integer) as dynamic
        if depth < 0
            return invalid
        end if
        if IsAssociativeArray(data)
            found = data["chapters"]
            if IsArray(found) and found.Count() > 0 and IsAssociativeArray(found[0]) and IsAssociativeArray(found[0]["chapterRenderer"])
                return found
            end if
            for each key in data
                found = Innertube.FindChapterMarkers(data[key], depth - 1)
                if found <> invalid
                    return found
                end if
            end for
        else if IsArray(data)
            for each child in data
                found = Innertube.FindChapterMarkers(child, depth - 1)
                if found <> invalid
                    return found
                end if
            end for
        end if
        return invalid
    end function

    ' "0:00 Intro" / "1:02:03 - Part" lines of a description: chapters when there are at least 3, starting at 0:00.
    function ChaptersFromDescription(descriptionText as string) as object
        list = []
        timestampLine = CreateObject("roRegex", "^\s*[(\[]*((\d+:)*\d+:\d\d)[)\]]*\s*[-:|]*\s*(.+)$", "")
        for each line in descriptionText.Tokenize(Chr(10))
            match = timestampLine.Match(line)
            if match.Count() >= 4
                seconds = Innertube.TimestampSeconds(match[1])
                if seconds >= 0 and (list.Count() = 0 or seconds * 1000 > list[list.Count() - 1].startMs)
                    list.Push({ title: match[3].Trim(), startMs: seconds * 1000 })
                end if
            end if
        end for
        if list.Count() < 3 or list[0].startMs <> 0
            return []
        end if
        return list
    end function

    ' "1:02:03" -> 3723, -1 when it isn't a timestamp
    function TimestampSeconds(stamp as string) as integer
        parts = stamp.Tokenize(":")
        if parts.Count() < 2 or parts.Count() > 3
            return -1
        end if
        total = 0
        for each part in parts
            total = total * 60 + part.ToInt()
        end for
        return total
    end function

end namespace
