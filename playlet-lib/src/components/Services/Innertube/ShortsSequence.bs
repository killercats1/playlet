import "pkg:/components/Services/Innertube/Context.bs"
import "pkg:/source/services/HttpClient.bs"
import "pkg:/source/utils/StringUtils.bs"
import "pkg:/source/utils/Types.bs"

' YouTube's endless Shorts feed (what the phone app loads while you swipe): reel_item_watch on a Short gives the
' sequence parameters, reel_watch_sequence gives the next Shorts and a token for the batch after.
' Parsing is deliberately loose (any reelWatchEndpoint video, any continuation token) since these responses
' change shape often.
namespace InnertubeShorts

    ' -> { items: [{ type: "video", videoId }], continuation } or { error }
    ' more: "v:<videoId>" to start from a Short, "c:<token>" to continue.
    function GetMore(more as string, accessToken as dynamic, onBehalfOfUser as dynamic, cancellation as dynamic) as object
        excludeId = ""
        if more.StartsWith("v:")
            excludeId = more.Mid(2)
            itemWatch = InnertubeShorts.Request("reel/reel_item_watch", {
                "playerRequest": { "videoId": excludeId }
                "params": "CAUwAg%3D%3D"
                "disablePlayerResponse": true
            }, accessToken, onBehalfOfUser, cancellation)
            if itemWatch.error <> invalid
                return itemWatch
            end if
            sequenceParams = InnertubeShorts.FindString(itemWatch.json, "sequenceContinuation", 12)
            if sequenceParams = ""
                return { error: "No Shorts sequence for " + excludeId }
            end if
            sequence = InnertubeShorts.Request("reel/reel_watch_sequence", { "sequenceParams": sequenceParams }, accessToken, onBehalfOfUser, cancellation)
        else if more.StartsWith("c:")
            token = more.Mid(2)
            sequence = InnertubeShorts.Request("reel/reel_watch_sequence", { "continuation": token }, accessToken, onBehalfOfUser, cancellation)
            if sequence.error <> invalid or InnertubeShorts.ParseSequence(sequence.json, "").items.Count() = 0
                sequence = InnertubeShorts.Request("reel/reel_watch_sequence", { "sequenceParams": token }, accessToken, onBehalfOfUser, cancellation)
            end if
        else
            return { error: "Invalid Shorts request" }
        end if

        if sequence.error <> invalid
            return sequence
        end if
        result = InnertubeShorts.ParseSequence(sequence.json, excludeId)
        if result.items.Count() = 0
            return { error: "No more Shorts" }
        end if
        return result
    end function

    ' A WEB client request, signed in when possible; if YouTube refuses the sign-in, retried without it (the
    ' Shorts are then not personalized, but keep coming).
    function Request(path as string, body as object, accessToken as dynamic, onBehalfOfUser as dynamic, cancellation as dynamic) as object
        attempts = [false]
        if not StringUtils.IsNullOrEmpty(accessToken)
            attempts = [true, false]
        end if

        lastError = ""
        for each signedIn in attempts
            options = {}
            if signedIn and not StringUtils.IsNullOrEmpty(onBehalfOfUser)
                options.onBehalfOfUser = onBehalfOfUser
            end if
            payload = { "context": Innertube.CreateContext(Innertube.ClientType.Web, CreateObject("roDeviceInfo"), options) }
            payload.Append(body)
            request = HttpClient.Post(`https://www.youtube.com/youtubei/v1/${path}?prettyPrint=false&alt=json`).JsonBody(payload)
            request.Headers(Innertube.CreateHeaders(Innertube.ClientType.Web))
            if signedIn
                request.Header("Authorization", "Bearer " + accessToken)
            end if
            request.Cancellation(cancellation)
            response = request.Await()
            if response.IsSuccess()
                json = response.Json()
                if IsAssociativeArray(json)
                    return { json: json }
                end if
            end if
            lastError = response.ErrorMessage()
        end for
        return { error: lastError }
    end function

    function ParseSequence(json as dynamic, excludeId as string) as object
        items = []
        seen = {}
        if excludeId <> ""
            seen[excludeId] = true
        end if
        InnertubeShorts.CollectReelVideos(json, items, seen, 20)
        return {
            items: items
            continuation: InnertubeShorts.TokenOf(InnertubeShorts.FindKey(json, "continuationCommand", 12))
        }
    end function

    function CollectReelVideos(data as dynamic, items as object, seen as object, depth as integer) as void
        if depth < 0
            return
        end if
        if IsAssociativeArray(data)
            endpoint = data["reelWatchEndpoint"]
            if IsAssociativeArray(endpoint) and IsString(endpoint["videoId"]) and endpoint["videoId"] <> ""
                videoId = endpoint["videoId"]
                if not seen.DoesExist(videoId)
                    seen[videoId] = true
                    items.Push({ "type": "video", "videoId": videoId })
                end if
            end if
            for each key in data
                InnertubeShorts.CollectReelVideos(data[key], items, seen, depth - 1)
            end for
        else if IsArray(data)
            for each child in data
                InnertubeShorts.CollectReelVideos(child, items, seen, depth - 1)
            end for
        end if
    end function

    function TokenOf(continuationCommand as dynamic) as string
        if IsAssociativeArray(continuationCommand)
            return ValidString(continuationCommand["token"])
        end if
        return ""
    end function

    function FindString(data as dynamic, key as string, depth as integer) as string
        return ValidString(InnertubeShorts.FindKey(data, key, depth))
    end function

    function FindKey(data as dynamic, key as string, depth as integer) as dynamic
        if depth < 0
            return invalid
        end if
        if IsAssociativeArray(data)
            if data.DoesExist(key)
                return data[key]
            end if
            for each childKey in data
                found = InnertubeShorts.FindKey(data[childKey], key, depth - 1)
                if found <> invalid
                    return found
                end if
            end for
        else if IsArray(data)
            for each child in data
                found = InnertubeShorts.FindKey(child, key, depth - 1)
                if found <> invalid
                    return found
                end if
            end for
        end if
        return invalid
    end function

end namespace

