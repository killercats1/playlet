<component name="VideoDetailsView" extends="Group" includes="AutoBind,Focus">
    <!-- Video details page, opened from a video's options menu ("Video details"): thumbnail, title, channel,
         views/date/likes and the description, with Play and Open Channel buttons. Shows what the row already
         knows right away, then fills in the rest (VideoDetailsJob). Back closes it. -->
    <interface>
        <field id="content" type="node" onChange="OnContentSet" />
        <field id="appController" type="node" bind="/AppController" />
        <field id="invidious" type="node" bind="/Invidious" />
        <field id="preferences" type="node" bind="/Preferences" />
        <field id="jobQueue" type="node" bind="/JobQueue" />
        <field id="videoQueue" type="node" bind="/VideoQueue" />
    </interface>
    <children>
        <Rectangle width="1280" height="720" color="0x181818" />

        <Poster
            id="thumbnail"
            translation="[80, 70]"
            width="560"
            height="315"
            loadWidth="560"
            loadHeight="315"
            loadDisplayMode="scaleToZoom"
            failedBitmapUri="pkg:/images/thumbnail-missing.jpg" />

        <LayoutGroup translation="[680, 70]" layoutDirection="vert" itemSpacings="[14, 6, 6, 6]">
            <Label id="titleLabel" width="520" wrap="true" maxLines="3" color="0xF1F1F1">
                <Font role="font" uri="font:BoldSystemFontFile" size="30" />
            </Label>
            <Label id="authorLabel" width="520" color="0xF1F1F1">
                <Font role="font" uri="font:MediumSystemFontFile" size="24" />
            </Label>
            <Label id="subscribersLabel" width="520" color="0xAAAAAA">
                <Font role="font" uri="font:SystemFontFile" size="20" />
            </Label>
            <Label id="statsLabel" width="520" wrap="true" maxLines="2" color="0xAAAAAA">
                <Font role="font" uri="font:SystemFontFile" size="20" />
            </Label>
            <Label id="likesLabel" width="520" color="0xAAAAAA">
                <Font role="font" uri="font:SystemFontFile" size="20" />
            </Label>
        </LayoutGroup>

        <ButtonEx
            id="playButton"
            focusable="true"
            iconVisible="false"
            padding="[30,30]"
            translation="[80, 410]" />
        <ButtonEx
            id="channelButton"
            focusable="true"
            iconVisible="false"
            padding="[30,30]"
            translation="[300, 410]" />

        <Label
            id="descriptionLabel"
            translation="[80, 500]"
            width="1120"
            height="190"
            wrap="true"
            maxLines="7"
            lineSpacing="2"
            color="0xCCCCCC">
            <Font role="font" uri="font:SystemFontFile" size="20" />
        </Label>
    </children>
</component>
