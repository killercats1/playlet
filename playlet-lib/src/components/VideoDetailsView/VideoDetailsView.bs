import "pkg:/components/ChannelView/ChannelUtils.bs"
import "pkg:/components/JobSystem/Jobs.bs"
import "pkg:/components/JobSystem/JobSystem.bs"
import "pkg:/components/Navigation/Navigation.bs"
import "pkg:/components/Services/Invidious/InvidiousToContentNode.bs"
import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/Logging.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/StringUtils.bs"
import "pkg:/source/utils/Types.bs"

function Init()
    m.top.focusable = true
    m.thumbnail = m.top.findNode("thumbnail")
    m.titleLabel = m.top.findNode("titleLabel")
    m.authorLabel = m.top.findNode("authorLabel")
    m.subscribersLabel = m.top.findNode("subscribersLabel")
    m.statsLabel = m.top.findNode("statsLabel")
    m.likesLabel = m.top.findNode("likesLabel")
    m.descriptionLabel = m.top.findNode("descriptionLabel")
    m.playButton = m.top.findNode("playButton")
    m.channelButton = m.top.findNode("channelButton")
    m.watchLaterButton = m.top.findNode("watchLaterButton")
    m.detailsJob = invalid
    m.watchLaterJob = invalid
    m.authorId = ""
end function

function OnNodeReady()
    m.playButton.text = Tr(Locale.ContextMenu.PlayVideo)
    m.channelButton.text = Tr(Locale.ContextMenu.OpenChannel)
    ' the channel button sits right of the play button, whatever width the play button's text gives it
    m.channelButton.translation = [m.playButton.translation[0] + m.playButton.boundingRect().width + 20, m.playButton.translation[1]]

    ' Save to Watch later, for YouTube accounts
    profile = m.top.profilesService.currentProfile
    canSave = profile <> invalid and profile.type = "youtube"
    m.watchLaterButton.text = Tr(Locale.ContextMenu.SaveToWatchLater)
    m.watchLaterButton.visible = canSave
    m.watchLaterButton.focusable = canSave
    UpdateButtonLayout()

    m.playButton.ObserveField("buttonSelected", FuncName(OnPlaySelected))
    m.channelButton.ObserveField("buttonSelected", FuncName(OnChannelSelected))
    m.watchLaterButton.ObserveField("buttonSelected", FuncName(OnWatchLaterSelected))

    LoadDetails()
end function

function OnFocusChange() as void
    if not m.top.focus
        return
    end if
    NodeSetFocus(m.playButton, true)
end function

function OnContentSet() as void
    content = m.top.content
    if content = invalid
        return
    end if

    m.thumbnail.uri = content.thumbnail
    m.titleLabel.text = content.title
    m.authorLabel.text = content.author
    stats = []
    for each text in [content.viewCountText, content.publishedText, content.lengthText]
        if not StringUtils.IsNullOrEmpty(text)
            stats.Push(text)
        end if
    end for
    m.statsLabel.text = stats.Join(" • ")
    SetAuthorId(ValidString(content.authorId))

    LoadDetails()
end function

function LoadDetails() as void
    content = m.top.content
    if content = invalid or m.top.jobQueue = invalid or m.detailsJob <> invalid
        return
    end if
    m.detailsJob = JobSystem.CreateCallback(OnDetailsJobDone)
    JobSystem.QueueJob(m.top.jobQueue, Jobs.VideoDetailsJob, {
        videoId: content.videoId
        invidious: m.top.invidious
        preferences: m.top.preferences
    }, m.detailsJob)
end function

function OnDetailsJobDone(event as object) as void
    JobSystem.UnobserveCallback(event.getRoSGNode())
    info = event.getInfo()
    if not info.success or not IsAssociativeArray(info.data) or not IsAssociativeArray(info.data.details)
        LogWarnNoTelemetry("Video details not available:", info.error)
        return
    end if
    details = info.data.details

    if details.title <> ""
        m.titleLabel.text = details.title
    end if
    if details.author <> ""
        m.authorLabel.text = details.author
    end if
    m.subscribersLabel.text = details.subscribersText

    stats = []
    for each text in [details.viewsText, details.dateText]
        if text <> ""
            stats.Push(text)
        end if
    end for
    if stats.Count() > 0
        m.statsLabel.text = stats.Join(" • ")
    end if
    if details.likesText <> ""
        m.likesLabel.text = Tr(Locale.VideoDetails.Likes).Replace("%1", details.likesText)
    end if
    m.descriptionLabel.text = details.description
    if details.authorId <> ""
        SetAuthorId(details.authorId)
    end if
end function

function SetAuthorId(authorId as string) as void
    m.authorId = authorId
    hasChannel = authorId <> ""
    m.channelButton.visible = hasChannel
    m.channelButton.focusable = hasChannel
    UpdateButtonLayout()
end function

' The visible buttons in a row, left to right, with Left/Right between neighbors.
function UpdateButtonLayout() as void
    buttons = [m.playButton]
    if m.channelButton.visible
        buttons.Push(m.channelButton)
    end if
    if m.watchLaterButton.visible
        buttons.Push(m.watchLaterButton)
    end if
    ' drop the previous Left/Right links between the buttons (the first match wins in NavigationKeyHandler)
    if IsAssociativeArray(m._navigation)
        for each direction in [RemoteKeys.Left, RemoteKeys.Right]
            links = m._navigation[direction]
            if IsArray(links)
                kept = []
                for each link in links
                    if link.fromNode = invalid or not (link.fromNode.isSameNode(m.playButton) or link.fromNode.isSameNode(m.channelButton) or link.fromNode.isSameNode(m.watchLaterButton))
                        kept.Push(link)
                    end if
                end for
                m._navigation[direction] = kept
            end if
        end for
    end if
    x = m.playButton.translation[0]
    y = m.playButton.translation[1]
    for i = 0 to buttons.Count() - 1
        buttons[i].translation = [x, y]
        x += buttons[i].boundingRect().width + 20
        if i > 0
            SetNavigation(buttons[i], RemoteKeys.Left, buttons[i - 1])
            SetNavigation(buttons[i - 1], RemoteKeys.Right, buttons[i])
        end if
    end for
end function

function OnWatchLaterSelected() as void
    content = m.top.content
    if content = invalid or StringUtils.IsNullOrEmpty(content.videoId) or m.watchLaterJob <> invalid
        return
    end if
    m.watchLaterJob = JobSystem.CreateCallback(OnWatchLaterJobDone)
    JobSystem.QueueJob(m.top.jobQueue, Jobs.WatchLaterJob, {
        videoId: content.videoId
        profile: m.top.profilesService.currentProfile
    }, m.watchLaterJob)
end function

function OnWatchLaterJobDone(event as object) as void
    JobSystem.UnobserveCallback(event.getRoSGNode())
    m.watchLaterJob = invalid
    if event.getInfo().success = true
        m.watchLaterButton.text = Tr(Locale.ContextMenu.SavedToWatchLater)
    else
        m.watchLaterButton.text = Tr(Locale.ContextMenu.CouldNotSaveToWatchLater)
    end if
end function

function OnPlaySelected() as void
    content = m.top.content
    if content = invalid
        return
    end if
    m.top.videoQueue.playVideo = content
end function

function OnChannelSelected() as void
    if m.authorId = ""
        return
    end if
    channel = InvidiousContent.ToChannelContentNode(invalid, { authorId: m.authorId })
    ChannelUtils.Open(channel, m.top.appController)
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if NavigationKeyHandler(key, press).handled
        return true
    end if
    if press and key = RemoteKeys.Back
        Close()
        return true
    end if
    return false
end function

function Close() as void
    if m.detailsJob <> invalid
        m.detailsJob.cancel = true
        m.detailsJob = invalid
    end if
    m.top.appController@.PopScreen()
end function
