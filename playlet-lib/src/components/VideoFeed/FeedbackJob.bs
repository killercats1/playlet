import "pkg:/components/ContentNode/ProfileContentAuthTokenUtils.bs"
import "pkg:/components/Services/Innertube/Context.bs"
import "pkg:/source/services/HttpClient.bs"

' Sends YouTube a "Not interested" / "Don't recommend channel" for the signed-in account (feedback token from
' the feed item's menu). input: { token, profile }
@job("FeedbackJob")
function ExecuteJob() as void
    input = JobGetInput()
    token = ValidString(input.token)
    profile = input.profile
    if token = ""
        JobError("No feedback token")
        return
    end if
    if profile = invalid or profile.type <> "youtube"
        JobError("Feedback needs a YouTube account")
        return
    end if
    auth = ProfileContentAuthTokenUtils.EnsureFreshAccessToken(profile)
    if auth.state <> ProfileContentAuthTokenUtils.AccessTokenState.Ok
        JobError("No usable access token to send feedback: " + auth.state)
        return
    end if

    options = { accessToken: auth.token }
    if not StringUtils.IsNullOrEmpty(auth.activeIdentifyToken)
        options.onBehalfOfUser = auth.activeIdentifyToken
    end if
    request = HttpClient.Post("https://www.youtube.com/youtubei/v1/feedback?prettyPrint=false&alt=json").JsonBody({
        "context": Innertube.CreateContext(Innertube.ClientType.Tv, CreateObject("roDeviceInfo"), options)
        "feedbackTokens": [token]
        "isFeedbackTokenUnencrypted": false
        "shouldMerge": false
    })
    request.Headers(Innertube.CreateHeaders(Innertube.ClientType.Tv))
    request.Header("Authorization", "Bearer " + auth.token)
    request.Cancellation(JobGetCancellation())
    response = request.Await()
    if not response.IsSuccess()
        JobError("Failed to send feedback: " + response.ErrorMessage())
        return
    end if
    JobSuccess()
end function
