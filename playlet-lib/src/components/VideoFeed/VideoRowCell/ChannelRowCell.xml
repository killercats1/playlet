<component name="ChannelRowCell" extends="Group">
    <interface>
        <field id="type" type="string" value="channel" />
        <field id="_author" type="string" alias="authorLabel.text" />
        <field id="subCountText" type="string" alias="subCountLabel.text" />
        <field id="channelHandle" type="string" alias="handleLabel.text" />
        <field id="thumbnail" type="uri" alias="thumbnail.uri" />
        <field id="itemContent" type="node" onChange="OnContentSet" />
    </interface>
    <children>
        <LayoutGroup
            itemSpacings="[24,5,5]">

            <CirclePoster
                id="thumbnail"
                loadDisplayMode="scaleToFill"
                loadWidth="196"
                loadHeight="196"
                width="196"
                height="196"
                failedBitmapUri="pkg:/images/thumbnail-missing.jpg" />

            <Label
                id="authorLabel"
                width="196"
                maxLines="2"
                wrap="true">
                <Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="18" />
            </Label>
            <Label
                id="subCountLabel"
                width="196"
                maxLines="2"
                wrap="true">
                <Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="18" />
            </Label>
            <Label
                id="handleLabel"
                width="196"
                height="25">
                <Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="18" />
            </Label>
        </LayoutGroup>
    </children>
</component>