<component name="VideoRowCell" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="OnContentSet" />
        <field id="type" type="string" value="video" />
        <field id="title" type="string" alias="titleLabel.text" />
        <field id="author" type="string" alias="authorLabel.text" />
        <field id="viewCountDate" type="string" alias="viewCountDateLabel.text" />
        <field id="durationRectVisible" type="boolean" alias="durationRect.visible" />
        <field id="duration" type="string" alias="durationLabel.text" />
        <field id="thumbnailUri" type="string" alias="thumbnail.uri" />
        <field id="percentDurationWatched" type="float" onChange="OnPercentDurationWatched" />
        <!-- focused: after a moment, the thumbnail cycles through frames from the video -->
        <field id="previewActive" type="boolean" onChange="OnPreviewActiveChange" />
    </interface>
    <children>
        <Font id="smallestSystemFont" uri="pkg:/fonts/Roboto-Regular.ttf" size="18" />
        <Font id="smallestBoldSystemFont" uri="pkg:/fonts/Roboto-Medium.ttf" size="18" />
        <Timer id="previewTimer" duration="1.2" repeat="true" />

        <LayoutGroup
            itemSpacings="[24,5,5]">
            <Poster
                id="thumbnail"
                loadDisplayMode="scaleToZoom"
                loadWidth="350"
                loadHeight="196"
                width="350"
                height="196"
                failedBitmapUri="pkg:/images/thumbnail-missing.jpg">
                <Rectangle
                    id="durationRect"
                    width="60"
                    height="26"
                    color="0x000000"
                    opacity="0.8"
                    translation="[290, 162]">
                    <Label
                        height="26"
                        id="durationLabel"
                        horizAlign="center"
                        vertAlign="center"
                        translation="[8, 0]">
                        <Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="18" />
                    </Label>
                </Rectangle>
                <Rectangle
                    id="progressRect"
                    width="350"
                    height="5"
                    color="#FF0000"
                    translation="[0, 192]"
                    scale="[0, 1]">
                </Rectangle>
            </Poster>
            <Label
                id="titleLabel"
                width="350"
                maxLines="2"
                wrap="true">
                <Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="18" />
            </Label>
            <Label
                id="authorLabel"
                width="350"
                height="25">
                <Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="18" />
            </Label>
            <Label
                id="viewCountDateLabel"
                width="350"
                height="25">
                <Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="18" />
            </Label>
        </LayoutGroup>
    </children>
</component>