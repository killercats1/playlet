import "pkg:/source/utils/StringUtils.bs"
import "pkg:/source/utils/Types.bs"

namespace HomeScreenUtils

    ' preferences = invalid loads the rows as listed, without the "Edit home screen" layout.
    function GetFeed(feedFileName as string, preferences as dynamic) as object
        feed = StringUtils.ParseJsonSafe(ReadAsciiFile(feedFileName))
        for each item in feed
            item.title = Tr(item.title)

            for each feedSource in item.feedSources
                feedSource.title = Tr(feedSource.title)
            end for
        end for

        if preferences = invalid
            return ExpandRows(feed)
        end if

        homeLayout = preferences["misc.home_screen_layout"]
        if not IsArray(homeLayout) or homeLayout.Count() = 0
            return ExpandRows(feed)
        end if

        feedItems = {}
        for each item in feed
            feedItems[item["id"]] = item
        end for

        ' Sections missing from the saved layout (new sections, or layouts
        ' damaged by old bugs) render as enabled at the end of the feed.
        filteredFeed = []
        seenIds = {}
        for each item in homeLayout
            if IsAssociativeArray(item) and IsString(item.id)
                seenIds[item.id] = true
                if item.enabled = true and feedItems[item.id] <> invalid
                    filteredFeed.push(feedItems[item.id])
                end if
            end if
        end for

        for each item in feed
            if not seenIds.DoesExist(item["id"])
                filteredFeed.push(item)
            end if
        end for

        return ExpandRows(filteredFeed)
    end function

    ' A section with "expandRows": N becomes N rows, each asking for its own index (the Home shelves).
    function ExpandRows(feed as object) as object
        expanded = []
        for each item in feed
            count = ValidInt(item.expandRows)
            if count <= 0
                expanded.Push(item)
                continue for
            end if
            for i = 1 to count
                copy = StringUtils.ParseJsonSafe(FormatJson(item))
                copy.Delete("expandRows")
                copy.id = `${item.id}_${i}`
                for each feedSource in copy.feedSources
                    feedSource.id = `${feedSource.id}_${i}`
                    queryParams = feedSource.queryParams
                    if not IsAssociativeArray(queryParams)
                        queryParams = {}
                    end if
                    queryParams.index = i.ToStr()
                    feedSource.queryParams = queryParams
                end for
                expanded.Push(copy)
            end for
        end for
        return expanded
    end function

end namespace
