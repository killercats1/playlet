import "pkg:/components/ContextMenu/ContextMenuUtils.bs"
import "pkg:/components/Navigation/Navigation.bs"
import "pkg:/components/Screens/HomeScreen/HomeScreenUtils.bs"
import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/Types.bs"

' Shared by the row screens (Home, Subscriptions, Library): each has its own Init file that imports this.

const RECOMMENDED_FEED_SOURCE_ID = "inv_auth_recommended"
' the row list moves down to make room for the topic chips while they show
const ROWLIST_Y = 50
const ROWLIST_Y_WITH_CHIPS = 90
' coming back to Home after this long reloads it (like YouTube, so the feed isn't hours old)
const STALE_AFTER_SECONDS = 1800

function OnNodeReady()
    SetNavigation(invalid, RemoteKeys.Back, m.navBar)
    SetNavigation(invalid, RemoteKeys.Left, m.navBar)

    m.rowList@.BindNode()

    ' Only Home has the topic chips bar.
    m.chipBar = m.top.findNode("chipBar")
    if m.chipBar <> invalid
        SetNavigation(m.rowList, RemoteKeys.Up, m.chipBar)
        SetNavigation(m.chipBar, RemoteKeys.Down, m.rowList)
        m.chipBar.observeFieldScoped("selected", FuncName(OnChipSelected))
        m.chipBar.observeFieldScoped("hasChips", FuncName(OnHasChipsChange))
        m.rowList.observeFieldScoped("content", FuncName(OnRowListContentChange))
        m.chipBar.chips = TopicChips("")
    end if

    ' TODO:P1 home screen should only be refreshed when the user navigates to it
    ' (similar to bookmarks screen)
    if m.top.useHomeLayout
        m.preferences.observeFieldScoped("misc.home_screen_layout", FuncName(OnHomeLayoutChange))
    end if
    OnHomeLayoutChange()
end function

function OnHomeLayoutChange() as void
    preferences = invalid
    if m.top.useHomeLayout
        preferences = m.preferences
    end if
    m.rowList.feeds = HomeScreenUtils.GetFeed(m.top.feedFile, preferences)
    m.loadedAt = CreateObject("roDateTime").AsSeconds()
end function

function RefreshIfStale() as void
    if not m.top.useHomeLayout or not IsInt(m.loadedAt)
        return
    end if
    now = CreateObject("roDateTime").AsSeconds()
    if now - m.loadedAt < STALE_AFTER_SECONDS
        return
    end if
    LogInfo("Home was loaded", now - m.loadedAt, "seconds ago: refreshing")
    m.loadedAt = now
    m.rowList@.Refresh()
end function

' Watches the Recommended row so its topic chips (sent by YouTube with the feed) can show above the rows.
function OnRowListContentChange() as void
    content = m.rowList.content
    if content = invalid
        return
    end if
    for each row in content.getChildren(-1, 0)
        feedSources = row.feedSources
        if IsArray(feedSources) and feedSources.Count() > 0 and feedSources[0].id = RECOMMENDED_FEED_SOURCE_ID
            row.observeFieldScoped("feedSources", FuncName(OnRecommendedFeedSourcesChange))
        end if
    end for
end function

function OnRecommendedFeedSourcesChange(event as object) as void
    feedSources = event.getData()
    if not IsArray(feedSources) or feedSources.Count() = 0 or not IsAssociativeArray(feedSources[0].state)
        return
    end if
    chips = feedSources[0].state.sortOptions
    if IsArray(chips) and chips.Count() > 0
        m.chipBar.chips = chips
    end if
end function

function OnHasChipsChange() as void
    if m.chipBar.hasChips
        m.rowList.translation = [0, ROWLIST_Y_WITH_CHIPS]
    else
        m.rowList.translation = [0, ROWLIST_Y]
    end if
end function

' Playlet's own topic chips (YouTube sends none to the TV app); the backend maps each topic to a feed.
function TopicChips(selectedTopic as string) as object
    chips = [
        { title: Tr(Locale.Chips.All), topic: "" }
        { title: Tr(Locale.NavBar.Music), topic: "music" }
        { title: Tr(Locale.Chips.News), topic: "news" }
        { title: Tr(Locale.Chips.Gaming), topic: "gaming" }
        { title: Tr(Locale.Feed.Live), topic: "live" }
    ]
    for each chip in chips
        chip.isSelected = chip.topic = selectedTopic
    end for
    return chips
end function

' Reloads Recommended for the picked chip: one of Playlet's topics, or a YouTube chip (its token goes to the
' built-in backend as "chip", not "continuation", which paging adds on its own).
function OnChipSelected() as void
    chip = m.chipBar.selected
    if not IsAssociativeArray(chip)
        return
    end if
    queryParams = invalid
    if IsString(chip.topic)
        if chip.topic <> ""
            queryParams = { topic: chip.topic }
        end if
        m.chipBar.chips = TopicChips(chip.topic)
    else if IsString(chip.continuation)
        queryParams = { chip: chip.continuation }
    else
        return
    end if

    feeds = m.rowList.feeds
    if not IsArray(feeds)
        return
    end if
    for each feed in feeds
        if IsArray(feed.feedSources)
            for each feedSource in feed.feedSources
                if feedSource.id = RECOMMENDED_FEED_SOURCE_ID
                    feedSource.queryParams = queryParams
                end if
            end for
        end if
    end for
    m.rowList.feeds = feeds
    NodeSetFocus(m.rowList, true)
end function

function OnFocusChange() as void
    if not m.top.focus
        return
    end if
    RefreshIfStale()
    NodeSetFocus(m.rowList, true)
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if NavigationKeyHandler(key, press).handled
        return true
    end if
    return false
end function

function GetContextMenuOptionsForItem(_rowItem as object) as object
    title = Tr(Locale.ContextMenu.RefreshHome)
    if not m.top.useHomeLayout
        title = Tr(Locale.Buttons.Refresh)
    end if
    refresh = ContextMenuUtils.CreateOption(title, m.rowList, "Refresh", [invalid])
    return [refresh]
end function
