<component name="HomeScreen" extends="Group" includes="AutoBind,Focus,ContextMenuProvider">
    <interface>
        <field id="navBar" type="node" bind="/NavBar" />
        <field id="invidious" type="node" bind="/Invidious" />
        <field id="preferences" type="node" bind="/Preferences" />
        <field id="feedFile" type="string" value="libpkg:/config/default_home_layout.yaml" />
        <!-- the "Edit home screen" preference only applies to Home, not the other row screens sharing this code -->
        <field id="useHomeLayout" type="boolean" value="true" />
    </interface>
    <children>
        <!-- topic chips (All, Music, Gaming, ...) for the Recommended row; hidden unless YouTube sends them. -->
        <ChipBar id="chipBar" translation="[90, 22]" />
        <VideoRowList
            itemComponentName="RowCell"
            id="rowList"
            translation="[0,50]"
            numRows="2"
            rowitemSize="[[350,196]]"
            rowItemSpacing="[[25,0]]"
            itemSize="[1280,326]"
            itemSpacing="[0,65]"
            rowLabelOffset="[[90,20]]"
            focusXOffset="[90]"
            showRowLabel="[true]"
            rowFocusAnimationStyle="floatingfocus"
            variableWidthItems="true"
            focusBitmapUri="pkg:/images/focus-outline.$$RES$$.9.png"
        />
    </children>
</component>