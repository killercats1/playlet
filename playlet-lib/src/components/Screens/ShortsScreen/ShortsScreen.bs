import "pkg:/components/JobSystem/Jobs.bs"
import "pkg:/components/JobSystem/JobSystem.bs"
import "pkg:/components/Navigation/Navigation.bs"
import "pkg:/components/Services/Invidious/InvidiousService.bs"
import "pkg:/components/Services/Invidious/InvidiousToContentNode.bs"
import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/Logging.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/Types.bs"

const TILE_WIDTH = 200
const TILE_HEIGHT = 356
const TILE_SPACING = 24
const STRIP_X = 90
const STRIP_Y = 100
const STRIP_WIDTH = 1160

function Init()
    m.top.focusable = true
    m.titleLabel = m.top.findNode("titleLabel")
    m.messageLabel = m.top.findNode("messageLabel")
    m.strip = m.top.findNode("strip")
    m.titleLabel.text = Tr(Locale.Feed.Shorts)
    m.videos = []
    m.outlines = []
    m.focusedIndex = 0
    m.loadJob = invalid
    m.loaded = false
end function

function OnNodeReady()
    SetNavigation(invalid, RemoteKeys.Back, m.navBar)
    SetNavigation(invalid, RemoteKeys.Left, m.navBar)
    m.top.observeFieldScoped("visible", FuncName(OnVisibleChange))
    Load()
end function

' Reload each time the tab is shown again after a failed or empty load.
function OnVisibleChange() as void
    if m.top.visible and not m.loaded
        Load()
    end if
end function

function Load() as void
    if m.loadJob <> invalid
        return
    end if
    m.messageLabel.text = Tr(Locale.Shorts.Loading)
    m.loadJob = JobSystem.CreateCallback(OnLoadDone)
    JobSystem.QueueJob(m.top.jobQueue, Jobs.ShortsFeedJob, { invidious: m.top.invidious }, m.loadJob)
end function

function OnLoadDone(event as object) as void
    JobSystem.UnobserveCallback(event.getRoSGNode())
    m.loadJob = invalid
    info = event.getInfo()
    if not info.success
        if ValidString(info.error).InStr(Invidious.ERROR_NOT_AUTHENTICATED) <> -1
            m.messageLabel.text = Tr(Locale.Shorts.SignIn)
        else
            LogWarnNoTelemetry("Shorts not available:", info.error)
            m.messageLabel.text = Tr(Locale.Shorts.NoShorts)
        end if
        return
    end if

    instance = m.top.invidious@.GetInstance()
    videos = []
    for each item in ValidArray(info.data.items)
        if IsAssociativeArray(item) and IsString(item.videoId)
            node = InvidiousContent.ToVideoContentNode(invalid, item, instance)
            ' the player flips between Shorts with Up/Down
            node.addFields({ isShort: true })
            videos.Push(node)
        end if
    end for
    if videos.Count() = 0
        m.messageLabel.text = Tr(Locale.Shorts.NoShorts)
        return
    end if
    m.loaded = true
    m.messageLabel.text = ""
    BuildTiles(videos)
end function

function BuildTiles(videos as object) as void
    while m.strip.getChildCount() > 0
        m.strip.removeChildIndex(0)
    end while
    m.videos = videos
    m.outlines = []

    titleFont = CreateObject("roSGNode", "Font")
    titleFont.uri = "pkg:/fonts/Roboto-Medium.ttf"
    titleFont.size = 18
    for i = 0 to videos.Count() - 1
        video = videos[i]
        tile = m.strip.createChild("Group")
        tile.translation = [i * (TILE_WIDTH + TILE_SPACING), 0]

        poster = tile.createChild("Poster")
        poster.width = TILE_WIDTH
        poster.height = TILE_HEIGHT
        poster.loadWidth = TILE_WIDTH
        poster.loadHeight = TILE_HEIGHT
        ' YouTube's Short thumbnails show the tall frame in the middle: zoom in on it
        poster.loadDisplayMode = "scaleToZoom"
        poster.failedBitmapUri = "pkg:/images/thumbnail-missing.jpg"
        poster.uri = `https://i.ytimg.com/vi/${video.videoId}/hqdefault.jpg`

        outline = tile.createChild("Poster")
        outline.uri = "pkg:/images/focus-outline.$$RES$$.9.png"
        outline.translation = [-8, -8]
        outline.width = TILE_WIDTH + 16
        outline.height = TILE_HEIGHT + 16
        outline.visible = false
        m.outlines.Push(outline)

        title = tile.createChild("Label")
        title.translation = [0, TILE_HEIGHT + 10]
        title.width = TILE_WIDTH
        title.maxLines = 2
        title.wrap = true
        title.color = "#EBEBEBFF"
        title.font = titleFont
        title.text = video.title
    end for

    m.focusedIndex = 0
    UpdateFocus()
end function

function OnFocusChange() as void
    if not m.top.focus
        return
    end if
    ' bs:disable-next-line NO_SET_FOCUS
    m.top.setFocus(true)
    UpdateFocus()
end function

function UpdateFocus() as void
    hasFocus = m.top.isInFocusChain()
    for i = 0 to m.outlines.Count() - 1
        m.outlines[i].visible = hasFocus and i = m.focusedIndex
    end for
    tileStride = TILE_WIDTH + TILE_SPACING
    offset = m.focusedIndex * tileStride - (STRIP_WIDTH - tileStride)
    if offset < 0
        offset = 0
    end if
    m.strip.translation = [STRIP_X - offset, STRIP_Y]
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if press and m.videos.Count() > 0
        if key = RemoteKeys.Right and m.focusedIndex < m.videos.Count() - 1
            m.focusedIndex += 1
            UpdateFocus()
            return true
        else if key = RemoteKeys.Left and m.focusedIndex > 0
            m.focusedIndex -= 1
            UpdateFocus()
            return true
        else if key = RemoteKeys.Ok
            PlayFrom(m.focusedIndex)
            return true
        end if
    end if

    if press and (key = RemoteKeys.Left or key = RemoteKeys.Back)
        ' leaving for the side bar: drop the outline
        for each outline in m.outlines
            outline.visible = false
        end for
    end if
    return NavigationKeyHandler(key, press).handled
end function

' Queue all the Shorts and play from the selected one, so the player can flip with Up/Down.
function PlayFrom(index as integer) as void
    nodes = []
    for each video in m.videos
        node = video.clone(false)
        if not node.hasField("isShort")
            node.addFields({ isShort: true })
        end if
        nodes.Push(node)
    end for
    m.top.videoQueue.setQueueAndIndex = { videoNodes: nodes, index: index }
    m.top.videoQueue.play = true
end function
