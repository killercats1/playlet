<component name="ShortsScreen" extends="Group" includes="AutoBind,Focus">
    <!-- The Shorts tab: the account's Shorts as tall tiles. Left/Right move (Left at the first one goes back to
         the side bar), OK plays the Shorts from the selected one on; in the player Up/Down flip between them. -->
    <interface>
        <field id="navBar" type="node" bind="/NavBar" />
        <field id="invidious" type="node" bind="/Invidious" />
        <field id="jobQueue" type="node" bind="/JobQueue" />
        <field id="videoQueue" type="node" bind="/VideoQueue" />
    </interface>
    <children>
        <Label id="titleLabel" translation="[90, 36]" color="0xF1F1F1FF">
            <Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="30" />
        </Label>
        <Label id="messageLabel" translation="[90, 110]" width="1100" wrap="true" color="0xAAAAAAFF">
            <Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="24" />
        </Label>
        <Group id="strip" translation="[90, 100]" />
    </children>
</component>
