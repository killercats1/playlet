import "pkg:/components/Services/ApplicationInfo/LibManifestUtils.bs"
import "pkg:/source/utils/Locale.bs"

const LIB_CANARY_ZIP_URL = "https://github.com/iBicha/playlet/releases/download/canary/playlet-lib.zip"
const LIB_CANARY_SQUASHFS_URL = "https://github.com/iBicha/playlet/releases/download/canary/playlet-lib.squashfs.pkg"

function Init()
    m.top.text = GetAppVersion()
end function

' TODO:P2: refactor and move to appropriate place, reuse with web app
function GetAppVersion() as string
    ' This fork is always sideloaded (app id "dev"), so no "-dev" suffix: the label matches the build's file name.
    version = "v" + LibManifestUtils.GetLibVersion()

    scene = m.top.getScene()
    if scene.playletLibLoadedUrl <> invalid
        libUrl = scene.playletLibLoadedUrl.link
        libUrlType = scene.playletLibLoadedUrl.type

        if libUrlType = "custom" and (libUrl = LIB_CANARY_ZIP_URL or libUrl = LIB_CANARY_SQUASHFS_URL)
            version += "-canary"
        end if
        ' auto-update: the download didn't load, this is the copy inside the installed app
        if libUrlType = "embedded-zip"
            version += " " + Tr(Locale.NavBar.BuiltIn)
        else if libUrlType = "update-zip-plain"
            ' the update from the plain address, which the TV may have kept from an earlier launch
            version += " " + Tr(Locale.NavBar.SavedCopy)
        end if
    end if

    return version
end function
