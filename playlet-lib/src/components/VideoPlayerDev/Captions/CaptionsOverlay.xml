<component name="CaptionsOverlay" extends="Group">
    <!-- Captions drawn by Playlet itself, so turning them on never changes the TV's own caption setting
         (Video.globalCaptionMode is device-wide). The coordinator hands it the Video node and toggles
         `enabled`; it loads the content's caption track, follows the playback position, and draws the
         current cue above the bottom edge (higher while the player controls are up). -->
    <interface>
        <field id="video" type="node" onChange="OnVideoSet" />
        <field id="jobQueue" type="node" />
        <!-- the player's Chrome group: captions move up out of the way while it shows. -->
        <field id="chrome" type="node" />
        <field id="enabled" type="boolean" value="false" onChange="OnEnabledChange" />
        <field id="fullscreen" type="boolean" value="true" onChange="Refresh" />
    </interface>
    <children>
        <Timer id="tick" duration="0.2" repeat="true" />
        <Timer id="messageTimer" duration="3" repeat="false" />
        <Rectangle id="background" color="0x000000" opacity="0.65" visible="false" />
        <Label id="label" width="1040" translation="[120, 0]" horizAlign="center" wrap="true" maxLines="3"
            color="0xFFFFFF">
            <Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="30" />
        </Label>
    </children>
</component>
