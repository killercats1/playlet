<component name="UpNextPanel" extends="Group">
    <!-- "Up next": a strip of related videos along the bottom of the player (Down from the progress bar).
         Focus is virtual, like the ButtonRow: the coordinator keeps real focus on the Video node and moves
         `focusedIndex`; this only draws. `content` holds VideoContentNode children. -->
    <interface>
        <field id="content" type="node" onChange="OnContentChange" />
        <field id="focusedIndex" type="integer" value="0" onChange="OnFocusedIndexChange" />
        <field id="itemCount" type="integer" value="0" />
    </interface>
    <children>
        <Rectangle id="background" width="1280" height="300" translation="[0, 420]" color="0x000000" opacity="0.8" />
        <Label id="headerLabel" translation="[68, 440]" color="0xF1F1F1FF">
            <Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="24" />
        </Label>
        <Group id="strip" translation="[68, 484]" />
    </children>
</component>
