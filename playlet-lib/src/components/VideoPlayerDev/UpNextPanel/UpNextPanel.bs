import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/Types.bs"

const TILE_WIDTH = 280
const TILE_HEIGHT = 158
const TILE_SPACING = 24
const STRIP_X = 68
const STRIP_WIDTH = 1144

function Init()
    m.strip = m.top.findNode("strip")
    m.top.findNode("headerLabel").text = Tr(Locale.Player.UpNext)
    m.tiles = []
end function

function OnContentChange() as void
    while m.strip.getChildCount() > 0
        m.strip.removeChildIndex(0)
    end while
    m.tiles = []

    content = m.top.content
    count = 0
    if content <> invalid
        count = content.getChildCount()
    end if
    for i = 0 to count - 1
        video = content.getChild(i)
        tile = CreateObject("roSGNode", "Group")
        tile.translation = [i * (TILE_WIDTH + TILE_SPACING), 0]

        poster = tile.createChild("Poster")
        poster.width = TILE_WIDTH
        poster.height = TILE_HEIGHT
        poster.loadWidth = TILE_WIDTH
        poster.loadHeight = TILE_HEIGHT
        poster.loadDisplayMode = "scaleToZoom"
        poster.failedBitmapUri = "pkg:/images/thumbnail-missing.jpg"
        poster.uri = video.thumbnail

        ' white rounded outline around the focused tile (same 9-patch as the rows)
        outline = tile.createChild("Poster")
        outline.uri = "pkg:/images/focus-outline.$$RES$$.9.png"
        outline.translation = [-8, -8]
        outline.width = TILE_WIDTH + 16
        outline.height = TILE_HEIGHT + 16
        outline.visible = false

        title = tile.createChild("Label")
        title.translation = [0, TILE_HEIGHT + 10]
        title.width = TILE_WIDTH
        title.maxLines = 2
        title.wrap = true
        title.color = "#EBEBEBFF"
        titleFont = CreateObject("roSGNode", "Font")
        titleFont.uri = "pkg:/fonts/Roboto-Medium.ttf"
        titleFont.size = 18
        title.font = titleFont
        title.text = video.title

        m.strip.appendChild(tile)
        m.tiles.Push({ outline: outline })
    end for

    m.top.itemCount = count
    OnFocusedIndexChange()
end function

function OnFocusedIndexChange() as void
    index = m.top.focusedIndex
    for i = 0 to m.tiles.Count() - 1
        m.tiles[i].outline.visible = i = index
    end for
    ' keep the focused tile on screen
    tileStride = TILE_WIDTH + TILE_SPACING
    offset = index * tileStride - (STRIP_WIDTH - tileStride)
    if offset < 0
        offset = 0
    end if
    m.strip.translation = [STRIP_X - offset, 484]
end function
